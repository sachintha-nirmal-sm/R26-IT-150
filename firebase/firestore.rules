rules_version = '2';

// ============================================================
// Firestore Security Rules — AI-Powered Grade-Based Learning Platform
// ============================================================
// Complete implementation of all rules specified in Section 10 of
// mobile_app/devmini.md.
//
// Core principle: the Flutter client is never the source of truth for
// grades, scores, attempt counts, or generated content. All such writes
// happen via FastAPI + Firebase Admin SDK, which bypasses these rules.
// These rules exist purely to lock down what the client SDK can read/write.
//
// Role source of truth: the 'role' Firebase Auth custom claim.
// The users/{uid}.role field mirrors it for rule reads without a
// token round-trip (but the claim always wins for Auth decisions).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------

    // True if the caller is signed in at all.
    function isAuthenticated() {
      return request.auth != null;
    }

    // True if the caller carries the 'admin' custom claim.
    // This is the single source of truth for admin access — not the
    // users/{uid}.role field, which is only a mirror for UI display.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // True if the caller carries the 'student' custom claim.
    function isStudent() {
      return isAuthenticated() && request.auth.token.role == 'student';
    }

    // True if the caller's UID matches the path UID (owns the document).
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Reads the student's currentGrade from their profile doc.
    // Used to enforce grade-scoped lesson/quiz reads.
    function getUserGrade(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.currentGrade;
    }

    // Reads the parent lesson document to check grade + status.
    // Used by quizzes rules to avoid repeating the cross-document lookup.
    function getLessonData(lessonId) {
      return get(/databases/$(database)/documents/lessons/$(lessonId)).data;
    }

    // --------------------------------------------------------
    // users/{uid}
    // --------------------------------------------------------
    // - Owners and admins may read the profile.
    // - Public signup may CREATE the document only when role == 'student'
    //   (admin accounts are provisioned out-of-band, never via signup).
    // - Owners may UPDATE their own profile, EXCEPT for the
    //   'currentGrade' and 'role' fields — those are server-only writes
    //   (grade promotion via scheduled job; role via seed script / console).
    // - Nobody may delete a user document through the client SDK.
    // --------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if (isOwner(uid) && request.resource.data.role == 'student')
        || isAdmin();

      // Profile update: owner may change any field EXCEPT currentGrade or role.
      // The affectedKeys() check ensures neither field appears in the diff,
      // i.e. the client cannot add, change, or remove them.
      allow update: if isAdmin()
        || (isOwner(uid)
            && !(["currentGrade", "role"].hasAny(
                   request.resource.data.diff(resource.data).affectedKeys()
                 )));

      allow delete: if false;

      // --------------------------------------------------------
      // users/{uid} — student subcollections
      // --------------------------------------------------------
      // Principle: all of these are written exclusively by FastAPI
      // (Admin SDK). A malicious client must NOT be able to fake a
      // perfect score, unlock a 4th attempt, or alter analytics by
      // writing directly to any of these subcollections.
      // Rule: owner may read their own data; write = false for everyone.
      // --------------------------------------------------------

      match /gradeHistory/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /quizProgress/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /quizAttempts/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /wrongQuestions/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /feedback/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /weakTopics/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /youtubeRecommendations/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /finalQuizAttempts/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /performanceSummary/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // --------------------------------------------------------
    // lessons/{lessonId}
    // --------------------------------------------------------
    // Admins can read all lessons.
    // Students may only read a lesson if:
    //   (a) the lesson is published, AND
    //   (b) the lesson's grade matches the student's currentGrade.
    // Write is false — lesson metadata is created/edited via FastAPI only.
    // --------------------------------------------------------
    match /lessons/{lessonId} {
      allow read: if isAdmin()
        || (isAuthenticated()
            && resource.data.status == 'published'
            && resource.data.grade == getUserGrade(request.auth.uid));
      allow write: if isAdmin();

      // materials — raw PDFs/notes for RAG ingestion; client never reads these.
      // Uploads go through a FastAPI endpoint that writes to Cloud Storage and
      // updates this subcollection via Admin SDK.
      match /materials/{materialId} {
        allow read, write: if isAdmin();
      }

      // quizzes — same grade-check as the parent lesson.
      // The client only reads quiz metadata (title, status, maxAttempts,
      // activeQuestionBankVersionId). Questions are never served from here.
      match /quizzes/{quizId} {
        allow read: if isAdmin()
          || (isAuthenticated()
              && getLessonData(lessonId).status == 'published'
              && getLessonData(lessonId).grade == getUserGrade(request.auth.uid));
        allow write: if isAdmin();

        // questionBankVersions + their questions — client NEVER reads these.
        // The Flutter app calls GET /quizzes/{id}/start; FastAPI reads the
        // bank server-side via Admin SDK and returns a sanitized payload with
        // correctAnswer and explanation stripped out. This is the only reliable
        // way to prevent a student from reading the answer key directly.
        match /questionBankVersions/{versionId} {
          allow read: if isAdmin();
          allow write: if isAdmin();

          match /questions/{questionId} {
            allow read: if isAdmin();
            allow write: if isAdmin();
          }
        }
      }
    }

    // --------------------------------------------------------
    // finalQuizzes/{finalQuizId}
    // --------------------------------------------------------
    // Same answer-key protection as questionBankVersions above.
    // The client calls a FastAPI endpoint for attempt-start; FastAPI
    // serves a shuffled, answer-stripped payload via Admin SDK.
    // Neither the quiz metadata nor its questions subcollection is
    // readable by the client SDK.
    // --------------------------------------------------------
    match /finalQuizzes/{finalQuizId} {
      allow read: if isAdmin();
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    // --------------------------------------------------------
    // generationJobs/{jobId}
    // --------------------------------------------------------
    // Admins may poll job progress (status, progressPercent, resultVersionId).
    // Students should never see generation jobs.
    // Write is false — jobs are created and updated exclusively by FastAPI.
    // --------------------------------------------------------
    match /generationJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Search-safe indexes generated by FastAPI after PDF ingestion. They
    // contain keywords and lesson metadata only, never extracted PDF text.
    match /pdf_keywords/{indexId} {
      allow read: if isAdmin()
        || (isAuthenticated()
            && resource.data.grade == getUserGrade(request.auth.uid));
      allow write: if isAdmin();
    }

    // Admin Materials tab stores Cloudinary metadata and safe extracted
    // keywords here. Students can only read materials for their own grade.
    match /lesson_materials/{materialId} {
      allow read: if isAdmin()
        || (isAuthenticated()
            && ((getUserGrade(request.auth.uid) == 9
                 && resource.data.grade == "Grade 9")
                || (getUserGrade(request.auth.uid) == 10
                    && resource.data.grade == "Grade 10")
                || (getUserGrade(request.auth.uid) == 11
                    && resource.data.grade == "Grade 11")));
      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------------
    // analytics/**
    // --------------------------------------------------------
    // Admin-dashboard aggregates maintained by backend tasks.
    // Covers the nested sub-path structure:
    //   analytics/lessonStats/{lessonId}
    //   analytics/quizStats/{quizId}
    //   analytics/questionStats/{questionId}
    // Students should never see these docs.
    // Write is false — all rollups happen server-side via Admin SDK.
    // --------------------------------------------------------
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --------------------------------------------------------
    // Game-Based Measurement & Calculation — Practicals
    // --------------------------------------------------------
    // Separate from the quiz/RAG collections above. Configuration
    // (topics, practicals) is shared; student results/progress are
    // private. All writes go through FastAPI + Admin SDK so the
    // client cannot inflate scores, skip the demo gate, or bypass
    // attempt limits / server-side timers.
    //
    // Collection names follow project camelCase convention:
    //   topics, practicals, practicalResults,
    //   studentPracticals, studentProgress
    // (Word-doc aliases: practical_results, student_practicals,
    //  student_progress).
    // --------------------------------------------------------

    // topics/{topicId}
    // Grade-scoped grouping of practicals under a lesson.
    // Students may read active topics for their currentGrade only.
    match /topics/{topicId} {
      allow read: if isAdmin()
        || (isAuthenticated()
            && resource.data.isActive == true
            && resource.data.grade == getUserGrade(request.auth.uid));
      allow write: if isAdmin();
    }

    // practicals/{practicalId}
    // Master config for each Unity practical (timer, attempt limits,
    // scene, maxScore). Attempt limits MUST come from this document,
    // never from the client. Students may read active practicals for
    // their currentGrade only so they can render the hub / launch Unity.
    match /practicals/{practicalId} {
      allow read: if isAdmin()
        || (isAuthenticated()
            && resource.data.isActive == true
            && (resource.data.grade == getUserGrade(request.auth.uid)
                || practicalId == "grade9_density_water"
                || practicalId == "grade9_force_basic"
                || practicalId == "grade9_pressure_solid"));
      allow write: if isAdmin();
    }

    // practicalResults/{resultId}
    // Immutable record of each demo/practical completion.
    // Demo results do not count as official score; the backend still
    // writes them so attempt history is complete. Owner or admin may
    // read; nobody writes from the client SDK.
    match /practicalResults/{resultId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // studentPracticals/{studentId}_{practicalId}
    // Fast O(1) lookup of one student's progress on one practical
    // (demoAttemptsUsed, practicalAttemptsUsed, bestScore, currentState).
    // Owner or admin may read; writes are backend-only so a client
    // cannot reset attempts or mark a practical complete.
    match /studentPracticals/{id} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // studentProgress/{studentId}
    // Aggregated profile/dashboard progress (gradeProgress, averages).
    // Doc ID = Firebase Auth UID. Profile screens read this instead of
    // scanning every practicalResults document.
    match /studentProgress/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow write: if isAdmin();
    }

    // chat_sessions — written only by FastAPI (Admin SDK).
    match /chat_sessions/{sessionId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (isAuthenticated()
              && get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.studentId
                 == request.auth.uid);
        allow write: if false;
      }
    }

    // --------------------------------------------------------
    // Catch-all: deny everything not explicitly permitted above.
    // This is the security baseline — do not remove.
    // --------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
