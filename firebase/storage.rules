rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Unity WebGL / exported builds for a practical.
    // Path: practicals/{practicalId}/**  (matches practicals.unityBuildUrl)
    // Authenticated students/admins may download; uploads go through FastAPI.
    match /practicals/{practicalId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
